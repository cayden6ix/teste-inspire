# ---------------------------------------------------------------------------
# Variáveis usadas pelo docker-compose.yml da raiz.
# Copie para `.env` (cp .env.example .env) e ajuste. Nunca versione o `.env` real.
# Todas têm valor padrão no compose, exceto JWT_SECRET, que é obrigatória.
# ---------------------------------------------------------------------------

# --- Banco de dados (PostgreSQL do compose) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app_db
# Porta publicada no host (o container usa sempre 5432).
POSTGRES_PORT=5432
# SSL na conexão com o banco: false (padrão) | require (cifra sem validar o
# certificado) | verify-full (cifra e valida o certificado). O Postgres do
# compose não oferece SSL, então mantenha false aqui.
DATABASE_SSL=false
# Loga as queries SQL da API (true/false).
DATABASE_LOGGING=false

# --- Portas publicadas no host ---
BACKEND_PORT=3000
FRONTEND_PORT=8080

# --- Autenticação (JWT) ---
# Obrigatória, com no mínimo 32 caracteres. O valor abaixo é PÚBLICO e serve só para avaliação
# local: com ele a API sobe, mas registra um aviso no log (qualquer um poderia emitir tokens).
# Fora disso, gere um segredo próprio e único por ambiente:
#   openssl rand -hex 32
#   (ou) node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-valor-por-um-segredo-forte-de-no-minimo-32-chars
# Validade do token de acesso (ex.: 15m, 1h, 1d).
JWT_EXPIRES_IN=1h

# --- HTTP ---
# Origens liberadas no CORS, separadas por vírgula (o frontend do compose roda em :8080).
CORS_ORIGINS=http://localhost:8080
# Publica a documentação Swagger em /docs (true/false).
SWAGGER_ENABLED=true
# Proxies confiáveis à frente da API: false | true | número de saltos.
# No compose a API fica atrás do nginx do frontend (1 salto): o IP real do
# cliente vem do X-Forwarded-For e é usado pelo rate limit.
TRUST_PROXY=1

# --- Rate limit (por IP) ---
# Janela de contagem, em segundos, e limite geral de requisições por janela.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
# Limites mais rígidos para login e cadastro, na mesma janela.
THROTTLE_AUTH_LOGIN_LIMIT=10
THROTTLE_AUTH_REGISTER_LIMIT=5
# true desliga o rate limit (uso em testes automatizados).
THROTTLE_DISABLED=false
