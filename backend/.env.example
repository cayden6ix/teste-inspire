# ---------------------------------------------------------------------------
# Variáveis de ambiente do backend (execução local, fora do Docker).
# Copie para `.env` e ajuste. Nunca versione o `.env` real (já está no .gitignore).
# ---------------------------------------------------------------------------

# --- Aplicação ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Publica a documentação Swagger em /docs (true/false).
SWAGGER_ENABLED=true

# --- Banco de dados (PostgreSQL) ---
# Em desenvolvimento local, apontando para o Postgres do Docker Compose:
DATABASE_URL=postgres://app:app@localhost:5432/app_db
# SSL na conexão: false (padrão) | require (cifra sem validar o certificado) |
# verify-full (cifra e valida o certificado). Independe do NODE_ENV.
DATABASE_SSL=false
# Schema via migrations (`npm run migration:run`). Mantenha false em todos os ambientes.
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# --- Autenticação (JWT) ---
# Troque por um valor forte e único por ambiente (mínimo de 32 caracteres).
JWT_SECRET=troque-este-valor-por-um-segredo-forte-de-no-minimo-32-chars
JWT_EXPIRES_IN=1h

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Proxy reverso ---
# false (padrão) | true | número de saltos confiáveis. Use 1 atrás de um único
# proxy (ex.: nginx) para o rate limit enxergar o IP real via X-Forwarded-For.
TRUST_PROXY=false

# --- Rate limit (por IP) ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_LOGIN_LIMIT=10
THROTTLE_AUTH_REGISTER_LIMIT=5
# true desliga o rate limit (uso em testes automatizados).
THROTTLE_DISABLED=false

# --- Seed ---
# O seed cria contas com senha conhecida e recusa rodar com NODE_ENV=production,
# a menos que SEED_ALLOW_PROD=true.
SEED_ALLOW_PROD=false
