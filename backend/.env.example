# ---------------------------------------------------------------------------
# Variaveis de ambiente do backend
# Copie para `.env` e ajuste. Nunca versionar o `.env` real (ja esta no .gitignore).
# ---------------------------------------------------------------------------

# --- Aplicacao ---
NODE_ENV=development
PORT=3000
API_PREFIX=api

# --- Banco de dados (PostgreSQL) ---
# Em desenvolvimento local via Docker Compose:
DATABASE_URL=postgres://app:app@localhost:5432/app_db
# FASE 1 (sem migrations): cria/atualiza o schema a partir das entidades.
# Nunca ative em producao.
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# --- Autenticacao (JWT) ---
# Troque por um valor forte e unico por ambiente (min. 32 caracteres).
JWT_SECRET=troque-este-valor-por-um-segredo-forte-de-no-minimo-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=troque-este-refresh-secret-por-um-segredo-forte-unico
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
